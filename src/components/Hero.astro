---
---
<section class="hero dark gutter" aria-labelledby="h1">
  <div class="wrap">
    <div class="hero-top">
      <span class="lbl"><b>[ Power BI developer ]</b> AI-first report builds</span>
      <span class="lbl">( Toronto &middot; EST )</span>
    </div>
    <h1 id="h1">I design <span class="sel on-dark"><span class="h tl"></span><span class="h tr"></span><span class="h bl"></span><span class="h br"></span>pixel-perfect</span> <span class="soft">Power BI experiences for leaders.</span></h1>
    <div class="hero-sub">
      <p>Semantic models and reports built with AI agents, then finished by hand. Faster to ship, calmer to read, and owned by the team that uses them.</p>
      <div class="ctas">
        <a class="btn btn-accent" href="#work">See the work <span class="arr" aria-hidden="true">&rarr;</span></a>
        <a class="btn btn-line" href="#approach">How I build</a>
      </div>
    </div>

    <div class="stage" role="img" aria-label="A Power BI workforce report being edited by an AI agent">
      <div class="canvas">
        <div class="cv-head">
          <div><b>Workforce Pulse</b><small>Executive summary</small></div>
          <div class="seg" aria-hidden="true"><span>Month</span><span class="on">Quarter</span><span>Year</span></div>
        </div>
        <div class="cv-body">
          <div class="kpis">
            <div class="kpi"><small>Headcount</small><strong>4,812</strong><em class="g">+3.1% <span>vs LY</span></em></div>
            <div class="kpi sel"><span class="tag" aria-hidden="true">Card (new)</span><span class="h tl"></span><span class="h tr"></span><span class="h bl"></span><span class="h br"></span><small>Attrition rate</small><strong>11.4%</strong><em class="g">-1.2 pts <span>vs LY</span></em></div>
            <div class="kpi"><small>Internal fill rate</small><strong>62.0%</strong><em class="g">+4.5 pts <span>vs LY</span></em></div>
            <div class="kpi"><small>Time to fill</small><strong>38 days</strong><em class="r">+4 days <span>vs LY</span></em></div>
          </div>
          <div class="charts">
            <div class="panel">
              <h4>Attrition rate, rolling 12 months</h4>
              <svg viewBox="0 0 540 196" aria-hidden="true">
                <g stroke="#E4E4EA" stroke-width="1"><line x1="44" y1="20" x2="520" y2="20"/><line x1="44" y1="70" x2="520" y2="70"/><line x1="44" y1="120" x2="520" y2="120"/><line x1="44" y1="170" x2="520" y2="170"/></g>
                <text x="34" y="24" text-anchor="end">14%</text><text x="34" y="74" text-anchor="end">13%</text><text x="34" y="124" text-anchor="end">12%</text><text x="34" y="174" text-anchor="end">11%</text>
                <path d="M44,170 L44.0,75.0 L85.5,85.0 L127.0,80.0 L168.5,95.0 L210.0,105.0 L251.5,100.0 L293.0,115.0 L334.5,125.0 L376.0,130.0 L417.5,140.0 L459.0,145.0 L500.5,150.0 L500.5,170 Z" fill="#5B3BF5" fill-opacity=".09"/>
                <polyline points="44.0,50.0 85.5,55.0 127.0,45.0 168.5,60.0 210.0,65.0 251.5,70.0 293.0,75.0 334.5,75.0 376.0,80.0 417.5,85.0 459.0,90.0 500.5,90.0" fill="none" stroke="#A3A3AD" stroke-width="1.6" stroke-dasharray="4 3"/>
                <polyline points="44.0,75.0 85.5,85.0 127.0,80.0 168.5,95.0 210.0,105.0 251.5,100.0 293.0,115.0 334.5,125.0 376.0,130.0 417.5,140.0 459.0,145.0 500.5,150.0" fill="none" stroke="#5B3BF5" stroke-width="2.4" stroke-linejoin="round"/>
                <circle cx="500.5" cy="150" r="4.5" fill="#5B3BF5" stroke="#fff" stroke-width="2"/>
                <text x="506" y="140" style="fill:#5B3BF5;font-weight:700">11.4%</text>
                <text x="44" y="190" text-anchor="middle">Nov</text><text x="168.5" y="190" text-anchor="middle">Feb</text><text x="293" y="190" text-anchor="middle">May</text><text x="417.5" y="190" text-anchor="middle">Aug</text><text x="500.5" y="190" text-anchor="middle">Oct</text>
              </svg>
              <div class="legend"><span><i></i>This year</span><span><i class="ly"></i>Last year</span></div>
            </div>
            <div class="panel">
              <h4>Headcount by department</h4>
              <div class="hbar">
                <div><span>Operations</span><span class="t hi" style="--w:100%"></span><span class="v">1,642</span></div>
                <div><span>Sales</span><span class="t" style="--w:67.5%"></span><span class="v">1,108</span></div>
                <div><span>Technology</span><span class="t" style="--w:52.6%"></span><span class="v">864</span></div>
                <div><span>Finance</span><span class="t" style="--w:31.2%"></span><span class="v">512</span></div>
                <div><span>Other</span><span class="t" style="--w:24.4%"></span><span class="v">400</span></div>
                <div><span>HR</span><span class="t" style="--w:17.4%"></span><span class="v">286</span></div>
              </div>
            </div>
          </div>
        </div>


        <div class="cursor cur-ai" aria-hidden="true"><svg viewBox="0 0 18 18"><path d="M2 1.5l13 6.2-5.6 1.6L7.3 15z" fill="#5B3BF5" stroke="#fff" stroke-width="1.2" stroke-linejoin="round"/></svg><span>AI agent</span></div>
        <div class="cursor cur-me" aria-hidden="true"><svg viewBox="0 0 18 18"><path d="M2 1.5l13 6.2-5.6 1.6L7.3 15z" fill="#FF6A3D" stroke="#fff" stroke-width="1.2" stroke-linejoin="round"/></svg><span>Panav</span></div>
      </div>
      <div class="agent">
          <div class="agent-h"><span class="dot"></span><div><b>Agent session</b><small>Workforce.SemanticModel</small></div></div>
          <ol>
            <li><span class="ok"></span><span>Created 14 measures with descriptions</span><time>0:41</time></li>
            <li><span class="ok"></span><span>Built <code>Date</code> table, 6 relationships</span><time>1:12</time></li>
            <li><span class="ok"></span><span>Wrote 3 report pages as PBIR</span><time>2:05</time></li>
            <li><span class="ok"></span><span>Applied theme, padding set to 0</span><time>0:18</time></li>
            <li><span class="spin"></span><span>Waiting on design review</span><time>now</time></li>
          </ol>
        </div>
    </div>
  </div>
</section>
