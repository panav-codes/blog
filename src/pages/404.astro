---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" noindex>
  <section class="page-head dark gutter" style="padding-bottom:140px">
    <div class="wrap">
      <span class="lbl"><b>[ 404 ]</b> Blank visual</span>
      <h1>This page has no data.</h1>
      <p>The link may be old, or the page moved. <a class="inline-d" href="/">Back to the home page &rarr;</a></p>
    </div>
  </section>
</Base>
